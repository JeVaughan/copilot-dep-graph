{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "types": ["node"],
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/index.mts", "src/viewer.mts", "src/aggregate.mts", "src/types.mts", "src/parser/parse.mts", "src/parser/treesitter.mts", "src/parser/graph-diff.mts"],
  "exclude": []
}
